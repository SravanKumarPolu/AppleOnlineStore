# =============================================================================
# NovaCart backend — AUTHORITATIVE environment template
# =============================================================================
# Every variable below is read by current code (verified 2026-10-26 by scanning
# process.env usage in app.js, server.js, config/, controllers/, middleware/,
# models/, routes/, services/, utils/). Nothing aspirational is listed here —
# the legacy `env.example` file in this directory lists the old, unused set
# (Stripe, AWS, Redis, Twilio, FCM…) and is superseded by this file.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials.
#
# Values shown are the code-verified defaults; "required" means startup or the
# affected feature breaks without it. Placeholder values (your-…/change-…) are
# detected by config/startupValidation.js: with PAYPAL_ENV=live or
# NODE_ENV=production the process refuses to boot instead of failing at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | production | test
NODE_ENV=development
# HTTP port the API + Socket.IO listen on.
PORT=3001

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
# Complete connection string. A database in the path is respected verbatim;
# a bare host URI gets MONGODB_DB (default: e-commerce).
MONGODB_URI=mongodb://127.0.0.1:27017/novacart
# Optional database name applied only when MONGODB_URI has no path component.
# MONGODB_DB=e-commerce

# -----------------------------------------------------------------------------
# Authentication (required)
# -----------------------------------------------------------------------------
# Fatal in production when unset/placeholder. Use a long random value.
JWT_SECRET=change-me-to-a-long-random-string

# Single-operator admin identity (no DB-backed admin accounts exist yet).
ADMIN_EMAIL=your-admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# -----------------------------------------------------------------------------
# PayPal (required for PayPal checkout; sandbox is the default environment)
# -----------------------------------------------------------------------------
# sandbox | live — ONLY the literal "live" targets the live PayPal API.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Webhook id from the PayPal app that points at /api/orders/paypal/webhook.
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Webhook state machine tunables (milliseconds / attempts).
WEBHOOK_PROCESSING_LOCK_MS=30000
WEBHOOK_MAX_UNMATCHED_ATTEMPTS=10

# -----------------------------------------------------------------------------
# URLs / CORS
# -----------------------------------------------------------------------------
# Storefront origin: CORS allow-list, password-reset links, PayPal return URLs.
FRONTEND_URL=http://localhost:5173
# Admin panel origin: CORS allow-list.
ADMIN_URL=http://localhost:5174
# Optional extra comma-separated origins (CDN host, second storefront domain).
# CORS_EXTRA_ORIGINS=https://shop.example.com

# -----------------------------------------------------------------------------
# Email / SMTP (optional — password reset returns 200 but sends nothing)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
# true for implicit TLS (typically port 465), false for STARTTLS (587).
SMTP_SECURE=false
# Opt in to self-signed certificates — development only.
SMTP_ALLOW_SELF_SIGNED=false
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=NovaCart
# Product name used in email templates.
APP_NAME=NovaCart

# -----------------------------------------------------------------------------
# Cloudinary (optional — product image upload only)
# -----------------------------------------------------------------------------
# NOTE the exact names: CLOUDINARY_NAME / CLOUDINARY_SECRET_KEY
# (NOT CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_SECRET).
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret

# -----------------------------------------------------------------------------
# Operations
# -----------------------------------------------------------------------------
# Graceful-shutdown budget in milliseconds.
SHUTDOWN_TIMEOUT_MS=10000
# Debug endpoints (/api/orders/debug, /api/user/debug) are hidden with 404 in
# production unless this is explicitly "true".
ENABLE_DEBUG_ENDPOINTS=false
