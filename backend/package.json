{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "server": "node --watch server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "test:parallel": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:smoke": "node scripts/run-tests.js",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage --runInBand",
    "verify:startup": "node scripts/verify-startup.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:seed": "node scripts/seedCategories.js",
    "db:audit": "node scripts/checkDatabase.js",
    "db:migrate": "node scripts/migrateOrders.js",
    "analytics:populate": "node scripts/populateAnalytics.js",
    "email:test": "node scripts/test-email.js",
    "security:audit": "npm audit",
    "build": "node scripts/check-syntax.mjs",
    "deploy:staging": "echo 'Deploy to staging environment'",
    "deploy:production": "echo 'Deploy to production environment'",
    "test:security": "node --experimental-vm-modules node_modules/.bin/jest --runInBand",
    "paypal:sandbox": "node scripts/paypal-sandbox-check.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs --history",
    "security:distribution": "node scripts/verify-distribution.mjs --check",
    "load:test": "node scripts/load-test.mjs",
    "security:dangling": "node scripts/audit-dangling-blobs.mjs",
    "security:rotation": "node scripts/verify-credential-rotation.mjs",
    "verify:old-credentials": "node scripts/verify-old-credentials.mjs"
  },
  "author": "",
  "license": "ISC",
  "description": "Enhanced E-commerce Backend with Analytics, Social Login, and Advanced Features",
  "dependencies": {
    "@paypal/checkout-server-sdk": "^1.0.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.6.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.11.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1",
    "socket.io": "^4.8.1",
    "validator": "^13.12.0"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "prettier": "^3.1.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "nodejs",
    "express",
    "mongodb",
    "analytics",
    "social-login",
    "payments",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/ecommerce-mern-backend.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/ecommerce-mern-backend/issues"
