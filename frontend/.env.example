# NovaCart storefront — environment template
# Copy to `.env` (git-ignored). Only these two variables are read by the app
# (verified 2026-10-26); everything in the legacy `env.example` file in this
# directory is unused and superseded by this file.

# Base URL of the NovaCart API (no trailing slash).
VITE_BACKEND_URL=http://localhost:3001

# PayPal JS SDK client id. REQUIRED for PayPal checkout: when unset the
# storefront renders an explicit "PayPal payments are unavailable" state
# instead of falling back to another PayPal app (K-2 fix).
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id
